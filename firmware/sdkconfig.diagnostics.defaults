# ABOUTME: Enables bounded heap tracing and UART-only crash dumps for the isolated fixture.
# ABOUTME: Leaves normal firmware and the flash partition layout unchanged.
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_COREDUMP_DECODE_DISABLE=y
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
# CONFIG_ESP_COREDUMP_LOGS is not set
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_HEAP_TRACING_STACK_DEPTH=2
# CONFIG_HEAP_TRACE_HASH_MAP is not set
