# Rust needs more stack than C's defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The ESP32-A1S has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Rev v3.1 silicon has the PSRAM cache fix in hardware (Rust code never gets the compiler workaround).
CONFIG_ESP32_REV_MIN_3=y

# External PSRAM. malloc puts allocations of 8 KB and up there: the fingerprint rings, the audio ring,
# and the fingerprint's 8 KB FFT tables and buffers. In internal RAM those held about 58 KB through
# every fingerprint, right before TLS needs a 16.7 KB block of it. With them in PSRAM, a fingerprint
# takes about 10.2 s at 80 MHz (below), against 16.5 s at 40 MHz. mbedTLS and thread stacks ask for
# internal RAM explicitly, so they stay there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8191

# Capture EOF/overflow interrupts must continue during NVS flash writes. IDF also
# allocates ISR-referenced controller/channel/queue state from internal RAM.
CONFIG_I2S_ISR_IRAM_SAFE=y

# Release TLS record buffers between operations while keeping TLS allocation in internal RAM.
# Retain certificate/config data so connection setup and reconnect keep the same trust policy.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA is not set
# CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT is not set
# The fixed Audio Kit requires mapped PSRAM for the capture and encoded-frame rings.
# Fail at boot if it is absent rather than falling back to insufficient internal memory.
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set

# Flash and PSRAM at 80 MHz: the fingerprint's FFT buffers live in PSRAM (Task 11), so its speed is PSRAM-bound.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y

# A fingerprint keeps core 1 busy for seconds; watch only core 0's idle task.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Full speed: the fingerprint is CPU- and PSRAM-bound (ESP-IDF's ESP32 default is 160 MHz).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Encoder CPU measurements use task runtime counters, not elapsed encode-call latency.
# ESP_TIMER counts microseconds at a fixed rate; trace support is selected by this option.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y

# The stream server (stream.rs) holds up to 4 sockets: its listener, 2 listeners and a refused third.
# With httpd's up to 6 (listener, control, 4 clients), MQTT and the Shazam request, that's 12, over
# lwIP's default of 10. Each extra socket costs only a small table entry.
CONFIG_LWIP_MAX_SOCKETS=16
# Listener close drains queued audio for two seconds, then lwIP aborts any remaining payload.
CONFIG_LWIP_SO_LINGER=y

# lwIP keeps at most its TCP send buffer in flight per connection, so a stream listener gets at most
# that much per round trip. The WAV needs 288 kB/s and FLAC about 193 kB/s. Round trips from Harper's
# Mac averaged 63-116 ms under load on 2026-10-04, so the WAV needs 33 KB in flight at 115 ms; the
# default 5,760 bytes needs round trips under 20 ms (Task 15b).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=46080
# General Wi-Fi/lwIP allocations prefer PSRAM but can fall back to internal RAM. Mandatory PSRAM
# enables cached TX and the by-reference netif path. Static TX reserves about 25.6 KB internally;
# its 32-entry cache handles queued packets. Verify heap and throughput on the board.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
# Preserve receive/reordering bounds instead of adopting the PSRAM profile's larger defaults.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
