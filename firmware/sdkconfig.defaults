# Rust needs more stack than C's defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The ESP32-A1S has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Rev v3.1 silicon has the PSRAM cache fix in hardware (Rust code never gets the compiler workaround).
CONFIG_ESP32_REV_MIN_3=y

# External PSRAM. malloc puts allocations of 8 KB and up there: the fingerprint rings, the audio ring,
# and the fingerprint's 8 KB FFT tables and buffers. In internal RAM those held about 58 KB through
# every fingerprint, right before TLS needs a 16.7 KB block of it. With them in PSRAM, a fingerprint
# takes about 10.2 s at 80 MHz (below), against 16.5 s at 40 MHz. mbedTLS and thread stacks ask for
# internal RAM explicitly, so they stay there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8191
# Boot and report missing PSRAM instead of refusing to start.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Flash and PSRAM at 80 MHz: the fingerprint's FFT buffers live in PSRAM (Task 11), so its speed is PSRAM-bound.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y

# A fingerprint keeps core 1 busy for seconds; watch only core 0's idle task.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Full speed: the fingerprint is CPU- and PSRAM-bound (ESP-IDF's ESP32 default is 160 MHz).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The stream server (stream.rs) holds up to 4 sockets: its listener, 2 listeners and a refused third.
# With httpd's up to 6 (listener, control, 4 clients), MQTT and the Shazam request, that's 12, over
# lwIP's default of 10. Each extra socket costs only a small table entry.
CONFIG_LWIP_MAX_SOCKETS=16
# Lets stream.rs close a dropped listener with a reset (SO_LINGER of 0 s). Without it lwIP keeps a
# stalled listener's unsent audio in internal RAM for minutes.
CONFIG_LWIP_SO_LINGER=y
