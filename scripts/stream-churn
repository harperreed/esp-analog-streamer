#!/usr/bin/env bash
# ABOUTME: Exercises real stream admission and slot recovery while keeping stopped or trickling peers open.
# ABOUTME: Usage: scripts/stream-churn [HOST] [--rounds N] [--hold SECONDS] [--out DIR]; records status, timing and /api/state evidence.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
STREAM_CHURN_DEFAULT_OUT="$repo/target/stream-churn" exec uv run --quiet --no-project python3 - "$@" <<'PY'
import argparse
import json
import os
import socket
import sys
import threading
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


class CheckFailure(Exception):
    pass


class ConfigurationFailure(CheckFailure):
    pass


def positive_float(value):
    number = float(value)
    if not 0 < number < float("inf"):
        raise argparse.ArgumentTypeError("must be a finite positive number")
    return number


def positive_int(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    parser = argparse.ArgumentParser(
        prog="scripts/stream-churn",
        description="Open two real stream listeners, require 503 for a third, stop or trickle reads, "
        "then require two replacement listeners within 10 seconds after the hold. Keep every "
        "stalled peer open until the test ends to expose closing TCP connection retention. "
        "Requires Shazam off and continuous captured audio. Transport poll failures are recorded "
        "while later rounds continue, but any poll failure makes the overall result FAIL. "
        "Invalid configuration stops promptly. Very compressible silence or a "
        "large receive window can take longer to fill TCP buffers; increase --hold in that case. "
        "Trickle reads must stay below the stream byte rate to force a timeout. "
        "Admission recovery does not prove RAM reclamation: compare the board's heap logs.",
    )
    parser.add_argument("host", nargs="?", default="esp-shazam.local",
                        help="board hostname or IPv4 address (default: esp-shazam.local)")
    parser.add_argument("--rounds", type=positive_int, default=3, help="churn rounds (default: 3)")
    parser.add_argument("--hold", type=positive_float, default=12.0,
                        help="seconds with stopped or trickling reads (default: 12)")
    parser.add_argument("--path", choices=["/stream.flac", "/stream.wav"], default="/stream.flac",
                        help="stream endpoint (default: /stream.flac)")
    parser.add_argument("--trickle-bytes", type=positive_int,
                        help="read at most this many bytes each interval from retained peers; otherwise stop reading")
    parser.add_argument("--trickle-interval", type=positive_float, default=0.5,
                        help="seconds between retained-peer reads (default: 0.5)")
    parser.add_argument("--out", default=os.environ["STREAM_CHURN_DEFAULT_OUT"],
                        help="output directory; each run writes a dated subdirectory (default: target/stream-churn)")
    args = parser.parse_args()
    run_name = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    out = Path(args.out).resolve() / run_name
    out.mkdir(parents=True)
    started = time.monotonic()
    events = []
    lock = threading.Lock()
    errors = []
    configuration_errors = []
    configuration_failed = threading.Event()
    stalled_peers = []
    replacements = []
    stop_polling = threading.Event()
    poller = None
    completed = 0
    failure = None
    ip = None
    log = (out / "events.jsonl").open("w")

    def record(kind, **fields):
        event = {"elapsed_seconds": round(time.monotonic() - started, 3), "kind": kind, **fields}
        with lock:
            events.append(event)
            log.write(json.dumps(event) + "\n")
            log.flush()
            print(json.dumps(event), flush=True)

    def state():
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(f"http://{ip}/api/state", timeout=3) as response:
            try:
                value = json.load(response)
            except (ValueError, UnicodeError) as error:
                raise ConfigurationFailure("/api/state returned malformed JSON") from error
        record("state", state=value)
        if not isinstance(value, dict) or value.get("shazam_enabled") is not False:
            raise ConfigurationFailure("/api/state must report shazam_enabled=false")

    def observe_state():
        try:
            state()
        except ConfigurationFailure as error:
            configuration_errors.append(str(error))
            record("state_error", error=str(error), critical=True)
            configuration_failed.set()
            stop_polling.set()  # Wake the main thread's paced waits for prompt refusal.
            raise
        except Exception as error:
            errors.append(str(error))
            record("state_error", error=str(error), critical=False)

    def check_configuration():
        if configuration_failed.is_set():
            raise ConfigurationFailure(configuration_errors[-1])

    def poll_state():
        while not stop_polling.wait(1):
            try:
                observe_state()
            except ConfigurationFailure:
                return

    def connect(label, timeout=3):
        peer = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        timing = dict(connect_ms=None, send_ms=None, first_byte_ms=None, header_ms=None)
        head = bytearray()
        began = time.monotonic()
        phase = "setup"

        def report_timing(success):
            # Milestones are cumulative milliseconds from the start of this attempt.
            record("connection_timing", label=label, success=success,
                   failure_phase=None if success else phase, **timing,
                   partial_received_bytes=len(head),
                   elapsed_ms=round((time.monotonic() - began) * 1000, 3))

        try:
            # Set before connect so the SYN advertises a small window. Retained peers only
            # read after admission when trickling is requested; record the OS buffer as evidence.
            peer.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4096)
            receive_buffer = peer.getsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF)
            deadline = time.monotonic() + timeout
            peer.settimeout(timeout)
            phase = "connect"
            peer.connect((ip, 8000))
            timing["connect_ms"] = round((time.monotonic() - began) * 1000, 3)
            phase = "send"
            peer.sendall(f"GET {args.path} HTTP/1.1\r\nHost: esp-shazam\r\n\r\n".encode("ascii"))
            timing["send_ms"] = round((time.monotonic() - began) * 1000, 3)
            phase = "response_head"
            while b"\r\n\r\n" not in head:
                left = deadline - time.monotonic()
                if left <= 0:
                    raise CheckFailure(f"{label}: response head deadline passed")
                peer.settimeout(left)
                chunk = peer.recv(1024)
                if not chunk:
                    raise CheckFailure(f"{label}: connection closed before response head")
                if timing["first_byte_ms"] is None:
                    timing["first_byte_ms"] = round((time.monotonic() - began) * 1000, 3)
                head.extend(chunk)
                if len(head) > 4096:
                    raise CheckFailure(f"{label}: response head exceeds 4096 bytes")
            timing["header_ms"] = round((time.monotonic() - began) * 1000, 3)
            phase = "status_line"
            line = bytes(head).split(b"\r\n", 1)[0].decode("ascii")
            parts = line.split(" ", 2)
            if len(parts) < 2 or parts[0] != "HTTP/1.1":
                raise CheckFailure(f"{label}: invalid HTTP status line {line!r}")
            status = int(parts[1])
            record("admission", label=label, status=status, status_line=line,
                   receive_buffer_bytes=receive_buffer,
                   initial_body_bytes=len(head.split(b"\r\n\r\n", 1)[1]))
            report_timing(True)
            return peer, status
        except Exception as error:
            report_timing(False)
            peer.close()
            if isinstance(error, CheckFailure):
                raise
            raise CheckFailure(f"{label}: {error}") from error

    def require_status(label, expected):
        peer, status = connect(label)
        if status != expected:
            peer.close()
            raise CheckFailure(f"{label}: expected HTTP {expected}, received HTTP {status}")
        return peer

    def drain(peer, ended, stopping):
        try:
            peer.settimeout(0.5)
            while not stopping.is_set():
                try:
                    if not peer.recv(16 << 10):
                        break
                except socket.timeout:
                    continue
        except OSError as error:
            if not stopping.is_set():
                record("replacement_error", error=str(error))
        finally:
            ended.set()

    def trickle(peer, stopping, evidence):
        try:
            peer.settimeout(min(0.5, args.trickle_interval))
            while not stopping.wait(args.trickle_interval):
                try:
                    data = peer.recv(args.trickle_bytes)
                except socket.timeout:
                    continue
                if not data:
                    record("retained_eof", label=evidence["label"], bytes_read=evidence["bytes_read"])
                    break
                evidence["bytes_read"] += len(data)
                record("trickle_read", label=evidence["label"], bytes_read=len(data),
                       total_bytes_read=evidence["bytes_read"])
        except OSError as error:
            if not stopping.is_set():
                record("retained_error", label=evidence["label"], error=str(error),
                       bytes_read=evidence["bytes_read"])

    def close_replacements():
        for peer, ended, stopping, worker in replacements:
            stopping.set()
            try:
                peer.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            peer.close()
            if worker.ident is not None:
                worker.join()
        replacements.clear()

    try:
        ip = socket.getaddrinfo(args.host, 8000, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
        record("start", host=args.host, ip=ip, rounds=args.rounds, hold_seconds=args.hold,
               path=args.path, trickle_bytes=args.trickle_bytes, trickle_interval=args.trickle_interval,
               note="Slots and HTTP statuses are measured; RAM reclamation requires board heap logs.")
        state()
        poller = threading.Thread(target=poll_state)
        poller.start()
        for round_number in range(1, args.rounds + 1):
            check_configuration()
            for index in (1, 2):
                check_configuration()
                label = f"round {round_number} listener {index}"
                peer = require_status(label, 200)
                stopping = threading.Event()
                evidence = {"label": label, "bytes_read": 0}
                worker = (threading.Thread(target=trickle, args=(peer, stopping, evidence))
                          if args.trickle_bytes is not None else None)
                stalled_peers.append((peer, stopping, worker, evidence))
                if worker is not None:
                    worker.start()
            check_configuration()
            require_status(f"round {round_number} third listener", 503).close()
            stall_started = time.monotonic()
            record("hold", round=round_number, seconds=args.hold, retained_peers=len(stalled_peers))
            # Retained peers stay open; optional reads remain paced even during recovery probes.
            stop_polling.wait(args.hold)
            probe_started = time.monotonic()
            deadline = probe_started + 10
            while len(replacements) < 2:
                check_configuration()
                if any(ended.is_set() for _, ended, _, _ in replacements):
                    raise CheckFailure("a replacement stream ended before both slots recovered; check capture health")
                left = deadline - time.monotonic()
                if left <= 0:
                    raise CheckFailure(
                        f"round {round_number}: only {len(replacements)} of 2 slots recovered within 10 s "
                        f"after the {args.hold:g} s hold; verify capture and actual stream byte rate/window size")
                peer, status = connect(f"round {round_number} recovery probe", min(3, left))
                if status == 200:
                    ended, stopping = threading.Event(), threading.Event()
                    worker = threading.Thread(target=drain, args=(peer, ended, stopping))
                    replacements.append((peer, ended, stopping, worker))
                    worker.start()
                    record("slot_recovered", round=round_number, recovered_slots=len(replacements),
                           seconds_since_stall=round(time.monotonic() - stall_started, 3),
                           seconds_since_probe=round(time.monotonic() - probe_started, 3))
                else:
                    peer.close()
                    if status != 503:
                        raise CheckFailure(f"round {round_number}: recovery probe returned HTTP {status}")
                    stop_polling.wait(min(0.25, max(0, deadline - time.monotonic())))
            require_status(f"round {round_number} third replacement", 503).close()
            if any(ended.is_set() for _, ended, _, _ in replacements):
                raise CheckFailure("replacement streams ended during the active-slot check")
            check_configuration()
            observe_state()
            close_replacements()
            completed += 1
            record("round_completed", round=round_number, retained_stalled_peers=len(stalled_peers),
                   admission_checks_passed=True, transport_poll_errors=len(errors))
            # Let the server observe the replacement peers' closes before the next admission.
            stop_polling.wait(1)
    except KeyboardInterrupt:
        failure = "interrupted"
        record("failure", error=failure)
    except Exception as error:
        failure = str(error)
        record("failure", error=failure)
    finally:
        close_replacements()
        for peer, stopping, worker, _ in stalled_peers:
            stopping.set()
            try:
                peer.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            peer.close()
            if worker is not None and worker.ident is not None:
                worker.join()
        stop_polling.set()
        if poller is not None and poller.ident is not None:
            poller.join()
        if configuration_errors and failure is None:
            failure = f"board configuration poll failed: {configuration_errors[-1]}"
        if errors and failure is None:
            failure = f"board transport poll failed: {errors[-1]}"
        summary = {"passed": failure is None, "error": failure, "host": args.host, "ip": ip,
                   "requested_rounds": args.rounds, "completed_rounds": completed,
                   "hold_seconds": args.hold, "elapsed_seconds": round(time.monotonic() - started, 3),
                   "path": args.path, "trickle_bytes": args.trickle_bytes,
                   "trickle_interval": args.trickle_interval,
                   "retained_peer_reads": [evidence for _, _, _, evidence in stalled_peers],
                   "retained_peer_count": len(stalled_peers), "state_errors": errors,
                   "configuration_errors": configuration_errors,
                   "ram_reclamation_verified": False,
                   "note": "Compare supervisor heap logs to assess closing TCP PCB retention."}
        (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
        log.close()
        print(f"{'PASS' if failure is None else 'FAIL'} {out / 'summary.json'}", flush=True)
    return 0 if failure is None else 1


if __name__ == "__main__":
    sys.exit(main())
PY
