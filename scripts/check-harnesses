#!/usr/bin/env bash
# ABOUTME: Checks hardware harness parsing, private crash capture and bounded cleanup on the host.
# ABOUTME: Uses temporary files and imported functions; never contacts or resets a board.
set -euo pipefail
case "${1:-}" in
    --help) echo 'Usage: scripts/check-harnesses (no arguments). Checks UART framing and pressure geometry without hardware.'; exit 0 ;;
    '') ;;
    *) echo 'FAIL unknown argument (see scripts/check-harnesses --help)' >&2; exit 2 ;;
esac
[ "$#" -eq 0 ] || { echo 'FAIL unexpected arguments' >&2; exit 2; }
cd "$(dirname "$0")/.."
repo="$PWD"
uv run --quiet --project "$repo" --locked python3 scripts/test_harness_parsers.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_encoder_probe_check.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_noise_fixture.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_check_evidence.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_core_dump.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_media_fault_acceptance.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_stereo_capture.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_device_metrics.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_device_dashboard.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_sonos_http_check.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_network_fault.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_listener_churn.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_network_fault_batch.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_sonos_resume_probe.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_client_zoo.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_stream_soak_stalls.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_stream_soak_state_poll.py
uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_ota_push.py
exec uv run --quiet --project "$repo" --locked python3 -m unittest discover -s scripts -p test_harness_modules.py
