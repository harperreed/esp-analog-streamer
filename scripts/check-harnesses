#!/usr/bin/env bash
# ABOUTME: Checks the real hardware harness UART readers and internal-fragmentation parser on the host.
# ABOUTME: Uses temporary files and AST-extracted functions; never contacts or resets a board.
set -euo pipefail
case "${1:-}" in
    --help) echo 'Usage: scripts/check-harnesses (no arguments). Checks UART framing and pressure geometry without hardware.'; exit 0 ;;
    '') ;;
    *) echo 'FAIL unknown argument (see scripts/check-harnesses --help)' >&2; exit 2 ;;
esac
[ "$#" -eq 0 ] || { echo 'FAIL unexpected arguments' >&2; exit 2; }
cd "$(dirname "$0")/.."
exec uv run --quiet --no-project python3 - <<'PY'
import ast
import argparse
import contextlib
import io
import math
import sys
from types import SimpleNamespace
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path('scripts').resolve()))
from failure_observation import observation_seconds

def extracted(source, name, namespace):
    python = source.split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
    nodes = [node for node in ast.walk(ast.parse(python))
             if isinstance(node, (ast.FunctionDef, ast.ClassDef)) and node.name == name]
    assert len(nodes) == 1, f'expected exactly one {name}'
    exec(compile(ast.Module(body=nodes, type_ignores=[]), name, 'exec'), namespace)
    return namespace[name]


def reader_checks(source, label):
    with tempfile.TemporaryDirectory() as directory:
        uart = Path(directory) / 'uart.log'
        read = extracted(source, 'lines', {'uart': uart})
        assert read() == [], f'{label}: absent file'
        uart.write_bytes(b'complete\npartial')
        assert read() == ['complete'], f'{label}: partial line became visible'
        with uart.open('ab') as stream:
            stream.write(b'\r')
        assert read() == ['complete'], f'{label}: CR completed a line'
        with uart.open('ab') as stream:
            stream.write(b'\ninvalid\xff\nunfinished\xff')
        assert read() == ['complete', 'partial\r', 'invalid\ufffd'], f'{label}: LF/UTF-8 framing'


def geometry_checks(source):
    namespace = {}
    failure = extracted(source, 'Failure', namespace)
    validate = extracted(source, 'validate_internal_geometry', namespace)
    valid = dict(free=32768, largest=4095, experiment_floor=32768, sampled_min=32768,
                 stack_probe_failed=True, probe_before_free=32768, probe_before_largest=4095)
    validate(valid)
    invalid = [valid | patch for patch in
               [dict(stack_probe_failed=False), dict(stack_probe_failed=1),
                dict(probe_before_free=32767), dict(probe_before_largest=4096),
                dict(probe_before_largest=-1), dict(free=32767), dict(largest=4096),
                dict(sampled_min=32767), dict(sampled_min=32769), dict(experiment_floor=0)]]
    invalid += [{key: value for key, value in valid.items() if key != missing} for missing in valid]
    for index, fields in enumerate(invalid):
        try:
            validate(fields)
        except failure:
            continue
        raise AssertionError(f'geometry case {index} incorrectly accepted')


def endpoint_checks(source, name):
    python = source.split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
    tree = ast.parse(python)
    parsed_name = 'a' if name == 'encoder-fault-check' else 'args'
    body = tree.body if name == 'encoder-fault-check' else next(
        node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'main').body
    end = next(index for index, node in enumerate(body)
               if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == parsed_name for target in node.targets))
    parser_code = compile(ast.Module(body=body[:end + 1], type_ignores=[]), name, 'exec')
    namespace = dict(argparse=argparse, math=math, observation_seconds=observation_seconds)
    if name != 'encoder-fault-check':
        extracted(source, 'port', namespace)
    if name == 'stream-soak':
        extracted(source, 'seconds', namespace)
    original = sys.argv
    prefix = [name] + (['--mode', 'capture'] if name == 'fault-check' else [])
    try:
        for flags, expected in [(['--stream-port', '18000', '--state-port', '18080'], (18000, 18080)), ([], (8000, 80)),
                                (['--stream-port', '1', '--state-port', '65535'], (1, 65535))]:
            sys.argv = prefix + flags
            exec(parser_code, namespace)
            args = namespace[parsed_name]
            assert (args.stream_port, args.state_port) == expected
        if name == 'stream-soak':
            decoder_loop = next(node for node in ast.walk(tree) if isinstance(node, ast.For)
                                and isinstance(node.target, ast.Name) and node.target.id == 'index')
            for flags, expected in [(['--listeners', '1'], 1), (['--listeners', '2'], 2), ([], 2)]:
                sys.argv = prefix + flags
                exec(parser_code, namespace)
                assert namespace['args'].listeners == expected
                assert list(eval(compile(ast.Expression(decoder_loop.iter), name, 'eval'), namespace)) == list(range(1, expected + 1))
            for invalid in ['0', '3', '1.5', 'abc']:
                sys.argv = prefix + ['--listeners', invalid]
                with contextlib.redirect_stderr(io.StringIO()):
                    try:
                        exec(parser_code, namespace)
                    except SystemExit as error:
                        assert error.code == 2
                    else:
                        raise AssertionError('stream-soak accepted invalid listener count')
        for option in ['--stream-port', '--state-port']:
            for invalid in ['0', '65536', '-1', 'abc', '1.5', '１２', '9' * 5000]:
                sys.argv = prefix + [option, invalid]
                try:
                    with contextlib.redirect_stderr(io.StringIO()):
                        exec(parser_code, namespace)
                except SystemExit as error:
                    assert error.code == 2
                else:
                    raise AssertionError(f'{name}: accepted invalid {option}')
    finally:
        sys.argv = original
    selected = SimpleNamespace(host='127.0.0.1', stream_port=18000, state_port=18080, path='/stream.flac')
    environment = dict(ip='127.0.0.1', args=selected, a=selected)
    urls = [eval(compile(ast.Expression(node), name, 'eval'), environment)
            for node in ast.walk(tree) if isinstance(node, ast.JoinedStr)
            and isinstance(node.values[0], ast.Constant) and node.values[0].value == 'http://']
    assert 'http://127.0.0.1:18080/api/state' in urls
    assert 'http://127.0.0.1:18000/stream.flac' in urls
    for node in ast.walk(tree):
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'create_connection':
            assert eval(compile(ast.Expression(node.args[0]), name, 'eval'), environment) == ('127.0.0.1', 18000)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'getaddrinfo':
            assert eval(compile(ast.Expression(node.args[1]), name, 'eval'), environment) == 18000


def main():
    for name in ['fault-check', 'encoder-fault-check']:
        reader_checks(Path('scripts', name).read_text(), name)
    geometry_checks(Path('scripts/fault-check').read_text())
    for name in ['fault-check', 'stream-soak', 'encoder-fault-check']:
        endpoint_checks(Path('scripts', name).read_text(), name)
    print('PASS harness UART framing, internal geometry and actual endpoint parser checks (no hardware)')


if __name__ == '__main__':
    main()
PY
