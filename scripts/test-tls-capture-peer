#!/usr/bin/env bash
# ABOUTME: Runs real TLS/WebSocket regression checks for the receive-only capture peer.
# ABOUTME: Uses disposable OpenSSL certificates and loopback sockets without contacting hardware.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --quiet --no-project python3 scripts/test_tls_capture_peer.py "$@"
