#!/usr/bin/env bash
# ABOUTME: Checks real encoder suspension, listener cleanup and capture continuity on the board.
# ABOUTME: Flash encoder-faults first; this resets UART, requires Shazam off, and never flashes.
set -euo pipefail
if [[ "${1:-}" = --help ]]; then
    echo 'Usage: caffeinate -is scripts/encoder-fault-check [HOST] [--stream-port PORT] [--state-port PORT] [--path /stream.mp3|/stream.flac] [--out DIR]'
    echo 'Stream/state ports default to 8000/80; each must be 1..65535.'
    echo 'Two peers precede 2.5 s cooperative suspension; two fresh 10 s decoders follow.'
    echo 'After a 30 s recovery window, 17 s suspension must latch compressed admission failure.'
    echo 'Requires ffmpeg, ffprobe, uv and the encoder-faults image. Restore production afterward.'
    echo 'Private logs have a checked 128 MiB budget; polling may overshoot it.'
    exit 0
fi
repo="$(cd "$(dirname "$0")/.." && pwd)"
exec uv run --quiet --project "$repo" --locked python3 "$repo/scripts/encoder_fault_check.py" "$@"
