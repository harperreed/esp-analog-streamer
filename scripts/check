#!/usr/bin/env bash
# ABOUTME: Canonical project check: formatting, lints, Mac tests, and the firmware build once it exists.
# ABOUTME: Prints one ok/FAIL line per stage; full output lands in target/check-logs/<stage>.log.
set -uo pipefail
cd "$(dirname "$0")/.."
mise_env="$(mise env -s bash)" || { echo "FAIL  mise   (run: mise trust && mise install)"; exit 1; }
eval "$mise_env" # the toolchain pinned in mise.toml
LOG_DIR=target/check-logs
mkdir -p "$LOG_DIR"
status=0

stage() {
  local name="$1"
  shift
  if "$@" >"$LOG_DIR/$name.log" 2>&1; then
    echo "ok    $name"
  else
    echo "FAIL  $name   (full log: $LOG_DIR/$name.log)"
    tail -n 40 "$LOG_DIR/$name.log" | sed 's/^/      /'
    status=1
  fi
}

stage fmt cargo fmt --all -- --check
stage clippy cargo clippy --workspace --all-targets -- -D warnings
stage test cargo test --workspace
stage capture-loom cargo test -p esp-shazam-core --features capture-loom models:: --lib
stage listener-loom cargo test -p esp-shazam-core --features listener-loom --lib --test listener_runtime_loom models::
stage sonos-web node --test test/sonos-web.test.cjs
stage harnesses scripts/check-harnesses
stage coverage-host scripts/test-coverage-host
stage stream-format scripts/test-stream-format
stage decoder-integrity scripts/test-decoder-integrity
stage failure-observation scripts/test-failure-observation
stage tls-capture-peer scripts/test-tls-capture-peer
stage e2e-fixtures scripts/test-e2e-fixtures
stage interface-relay scripts/test-interface-relay
stage wifi-throughput scripts/test-wifi-throughput-check
if [ "$(uname -s)" = Linux ]; then
  stage setup-linux scripts/test-setup-linux
  stage capture-stream-packets scripts/test-capture-stream-packets
fi

if [ -d firmware ]; then
  stage firmware-fmt rustfmt --edition 2021 --check firmware/build.rs firmware/src/*.rs
  stage firmware-build bash -c 'cd firmware && { [ -f "$HOME/export-esp.sh" ] && . "$HOME/export-esp.sh"; true; } && cargo +esp build --release'
  stage i2s-iram-tests scripts/test-i2s-iram
  stage i2s-iram scripts/check-i2s-iram
  # cargo's summary line names our crates when they produce warnings
  stage firmware-warnings bash -c '! grep -E "^warning: .esp-shazam" target/check-logs/firmware-build.log'
fi

exit $status
