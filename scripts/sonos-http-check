#!/usr/bin/env bash
# ABOUTME: Runs the real-board HTTP Sonos acceptance harness in the locked uv project.
# ABOUTME: Use --help for fixture, image, serial and private evidence directory requirements.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
exec uv run --quiet --project "$repo" --locked python3 "$repo/scripts/sonos_http_check.py" "$@"
