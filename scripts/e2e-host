#!/usr/bin/env bash
# ABOUTME: Mac end-to-end test: fingerprints a real song clip and checks that the real Shazam names it.
# ABOUTME: Refreshes test/fixtures/shazam/ (real responses, lyrics stripped) that the parser tests read.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: scripts/e2e-host <song-file> \"<expected title>\"" >&2
  exit 2
fi
[ -f "$1" ] || { echo "FAIL: no such song file: $1" >&2; exit 2; }
song="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" # absolute, because of the cd below
expected="$2"

cd "$(dirname "$0")/.."
mise_env="$(mise env -s bash)" || { echo "FAIL  mise   (run: mise trust && mise install)"; exit 1; }
eval "$mise_env" # the toolchain pinned in mise.toml

songs=test/fixtures/songs
fixtures=test/fixtures/shazam
scratch=target/e2e # collect the complete candidate set before local validation/promotion
mkdir -p "$songs" "$fixtures" "$scratch"

# 12 s from the middle of the song, and 12 s of white noise, both 16 kHz mono 16-bit.
duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$song")
start=$(awk -v d="$duration" 'BEGIN { s = d / 2 - 6; if (s < 0) s = 0; print s }')
ffmpeg -v error -y -ss "$start" -t 12 -i "$song" -ac 1 -ar 16000 -sample_fmt s16 "$songs/clip.wav"
ffmpeg -v error -y -f lavfi -i "anoisesrc=d=12:c=white:r=16000:a=0.3" -ac 1 -sample_fmt s16 "$songs/noise.wav"

cargo build -q -p esp-shazam-tools
tool=target/debug/shazam-file

# Keep copyrighted lyrics out of git; the parser never reads them.
strip_lyrics() {
  jq 'if (.track.sections | type) == "array"
      then .track.sections |= map(select(.type != "LYRICS")) else . end' "$1" > "$1.tmp"
  mv "$1.tmp" "$1"
}

# Stripping only knows today's response shape; this catches lyrics that turn up somewhere else.
require_no_lyrics() {
  if grep -qi lyric "$1"; then
    echo "FAIL: $1 still mentions \"lyric\" after stripping; not saving it as a fixture (fix strip_lyrics)"
    exit 1
  fi
}

echo "== song clip"
out=$("$tool" "$songs/clip.wav" --save-response "$scratch/match.json")
echo "$out"
strip_lyrics "$scratch/match.json"
grep -q -- '^MATCH ' <<<"$out" && grep -i -F -q -- "$expected" <<<"$out" \
  || { echo "FAIL: expected a match containing \"$expected\""; exit 1; }
require_no_lyrics "$scratch/match.json"
jq -n --arg title "$expected" '{title: $title}' > "$scratch/match.expected.json"

echo "== white noise"
"$tool" "$songs/noise.wav" --save-response "$scratch/miss.json"
jq -e 'has("track") | not' "$scratch/miss.json" >/dev/null || { echo "FAIL: white noise matched a track"; exit 1; }
require_no_lyrics "$scratch/miss.json"
# Parser tests read the fixture paths. Keep an exact snapshot until both checks pass;
# a failed parser/golden check or interruption restores locally edited originals.
scripts/e2e-fixtures "$fixtures" "$scratch" bash -c '
  set -euo pipefail
  echo "== parser tests on the saved responses"
  cargo test -q -p esp-shazam-core --test shazam_fixtures

  echo "== golden test on the song clip"
  cargo test -q -p esp-shazam-core --test golden -- --ignored
'

echo "PASS e2e-host"
