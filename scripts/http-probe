#!/usr/bin/env bash
# ABOUTME: Times real board state requests by TCP/HTTP phase under one absolute deadline.
# ABOUTME: Keeps bounded private JSONL results, continues after failures and never changes the board.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
HTTP_PROBE_REPO="$repo" exec uv run --quiet --no-project python3 - "$@" <<'PY'
import argparse
import json
import math
import os
import re
import socket
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


class ProbeFailure(Exception):
    pass


def bounded_float(low, high):
    def parse(value):
        number = float(value)
        if not math.isfinite(number) or not low <= number <= high:
            raise argparse.ArgumentTypeError(f'must be finite within {low}..{high}')
        return number
    return parse


def count(value):
    number = int(value)
    if not 1 <= number <= 1000:
        raise argparse.ArgumentTypeError('must be within 1..1000')
    return number


def main():
    parser = argparse.ArgumentParser(
        prog='scripts/http-probe', description='Read-only GET /api/state phase timing: connect, send, headers, body and local socket close. '
        'One absolute deadline covers connect through body (default 5 s, matching server socket timeout). '
        'first_byte_ms measures from request start; response_bytes_received includes headers and body framing. '
        'Resolve IPv4 once before requests; DNS lies outside their deadline. Require HTTP 200, JSON and Shazam false. '
        'Verify Content-Length when present; support production chunked framing. Bound headers to 8 KiB, decoded body to 64 KiB. '
        'Continue the fixed sample count after errors, then exit 1 if any failed. Private JSONL stores timings, not response data. '
        'Local close timing does not measure board socket reclamation. No reset, flash or configuration changes.')
    parser.add_argument('host', nargs='?', default='esp-shazam.local')
    parser.add_argument('--count', type=count, default=30)
    parser.add_argument('--interval', type=bounded_float(0, 60), default=1.0, help='seconds between completed requests (default 1)')
    parser.add_argument('--deadline', type=bounded_float(0.01, 60), default=5.0, help='absolute request deadline in seconds (default 5)')
    parser.add_argument('--out', help='parent output directory (default target/http-probe)')
    args = parser.parse_args()
    os.umask(0o077)
    out = Path(args.out or Path(os.environ['HTTP_PROBE_REPO']) / 'target/http-probe').resolve() / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    out.mkdir(parents=True)
    dns_started = time.monotonic()
    try:
        ip = socket.getaddrinfo(args.host, 80, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
    except OSError:
        print(f'FAIL DNS resolution; output directory: {out}', file=sys.stderr)
        return 1
    dns_ms = round((time.monotonic() - dns_started) * 1000, 3)
    failed = 0
    with (out / 'events.jsonl').open('w') as log:
        for index in range(args.count):
            peer = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            started = phase_started = time.monotonic()
            until = started + args.deadline
            phase = 'connect'
            result = dict(sample=index + 1, passed=False, timings_ms={})
            result['first_byte_ms'] = None
            buffered = bytearray()
            wire_bytes = 0

            def receive():
                nonlocal wire_bytes
                left = until - time.monotonic()
                if left <= 0:
                    raise TimeoutError('absolute deadline')
                peer.settimeout(left)
                data = peer.recv(4096)
                if not data:
                    raise ProbeFailure('premature EOF')
                if result['first_byte_ms'] is None:
                    result['first_byte_ms'] = round((time.monotonic() - started) * 1000, 3)
                wire_bytes += len(data)
                if wire_bytes > 144 * 1024:
                    raise ProbeFailure('wire size bound')
                buffered.extend(data)

            def take(size):
                while len(buffered) < size:
                    receive()
                data = bytes(buffered[:size])
                del buffered[:size]
                return data

            def line(limit):
                while b'\r\n' not in buffered:
                    if len(buffered) > limit:
                        raise ProbeFailure('line bound')
                    receive()
                end = buffered.index(b'\r\n')
                if end > limit:
                    raise ProbeFailure('line bound')
                return take(end + 2)[:-2]

            def completed_phase(next_phase):
                nonlocal phase, phase_started
                now = time.monotonic()
                result['timings_ms'][phase] = round((now - phase_started) * 1000, 3)
                phase, phase_started = next_phase, now

            try:
                peer.settimeout(max(0.001, until - time.monotonic()))
                peer.connect((ip, 80))
                completed_phase('send')
                left = until - time.monotonic()
                if left <= 0:
                    raise TimeoutError('absolute deadline')
                peer.settimeout(left)
                peer.sendall(f'GET /api/state HTTP/1.1\r\nHost: {ip}\r\nConnection: close\r\n\r\n'.encode('ascii'))
                completed_phase('headers')
                while b'\r\n\r\n' not in buffered:
                    if len(buffered) > 8192:
                        raise ProbeFailure('header bound')
                    receive()
                end = buffered.index(b'\r\n\r\n') + 4
                if end > 8192:
                    raise ProbeFailure('header bound')
                headers = take(end).decode('iso-8859-1').split('\r\n')
                status = headers[0].split()
                if len(status) < 2 or status[0] not in ('HTTP/1.0', 'HTTP/1.1') or status[1] != '200':
                    raise ProbeFailure('HTTP status must be 200')
                fields = {}
                for header in headers[1:-2]:
                    key, value = header.split(':', 1)
                    key = key.lower()
                    if key in fields:
                        raise ProbeFailure('duplicate header')
                    fields[key] = value.strip()
                completed_phase('body')
                body = bytearray()
                if 'transfer-encoding' in fields:
                    if fields['transfer-encoding'].lower() != 'chunked' or 'content-length' in fields:
                        raise ProbeFailure('ambiguous body framing')
                    result['framing'] = 'chunked'
                    while True:
                        token = line(1024).split(b';', 1)[0]
                        if re.fullmatch(rb'[0-9A-Fa-f]+', token) is None:
                            raise ProbeFailure('invalid chunk-size digits')
                        size = int(token, 16)
                        if size < 0 or len(body) + size > 65536:
                            raise ProbeFailure('body bound')
                        if size == 0:
                            trailers = 0
                            while trailer := line(1024):
                                trailers += len(trailer) + 2
                                if trailers > 8192:
                                    raise ProbeFailure('trailer bound')
                            break
                        body.extend(take(size))
                        if take(2) != b'\r\n':
                            raise ProbeFailure('invalid chunk ending')
                else:
                    token = fields['content-length']
                    if re.fullmatch(r'[0-9]+', token) is None:
                        raise ProbeFailure('invalid Content-Length digits')
                    length = int(token)
                    if not 0 <= length <= 65536:
                        raise ProbeFailure('body bound')
                    body.extend(take(length))
                    result.update(framing='content-length', content_length=length)
                if buffered:
                    raise ProbeFailure('bytes beyond framed response')
                value = json.loads(body)
                if not isinstance(value, dict) or value.get('shazam_enabled') is not False:
                    raise ProbeFailure('JSON must report shazam_enabled=false')
                if time.monotonic() > until:
                    raise TimeoutError('absolute deadline')
                result.update(passed=True, body_bytes=len(body))
                completed_phase('close')
            except Exception as error:
                failed += 1
                result.update(failed_phase=phase, error_type=type(error).__name__,
                              reason=str(error) if isinstance(error, ProbeFailure) else
                              'request deadline expired' if isinstance(error, TimeoutError) else
                              'invalid response or socket failure; response data omitted')
                completed_phase('close')
            finally:
                peer.close()
                result['timings_ms']['local_close'] = round((time.monotonic() - phase_started) * 1000, 3)
            result['total_ms'] = round((time.monotonic() - started) * 1000, 3)
            result['response_bytes_received'] = wire_bytes
            log.write(json.dumps(result) + '\n')
            log.flush()
            print(json.dumps(result), flush=True)
            if index + 1 < args.count:
                time.sleep(args.interval)
    summary = dict(passed=failed == 0, failed=failed, count=args.count, host=args.host, ip=ip,
                   dns_ms=dns_ms, deadline_seconds=args.deadline, log=str(out / 'events.jsonl'))
    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(f"{'PASS' if failed == 0 else 'FAIL'} {out / 'summary.json'}", flush=True)
    return int(failed != 0)


if __name__ == '__main__':
    sys.exit(main())
PY
