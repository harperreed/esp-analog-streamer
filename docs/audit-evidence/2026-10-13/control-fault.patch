+// Throwaway device acceptance probe; archive and remove after the bounded trials.
+#[cfg(target_os = "espidf")]
+pub mod control_fault {
+    use std::{sync::Mutex, time::Instant};
+
+    #[derive(Clone, Copy, PartialEq, Eq)]
+    pub struct Identity {
+        pub command_generation: u64,
+        pub sonos_intent: u64,
+        pub network_generation: u32,
+    }
+
+    type Receipt = fn(&str, Identity);
+    struct Gate {
+        spent: bool,
+        armed: Option<(Identity, Receipt)>,
+    }
+    static GATE: Mutex<Gate> = Mutex::new(Gate {
+        spent: false,
+        armed: None,
+    });
+
+    pub fn arm(identity: Identity, receipt: Receipt) -> bool {
+        let mut gate = GATE.lock().unwrap();
+        if gate.spent {
+            return false;
+        }
+        gate.spent = true;
+        gate.armed = Some((identity, receipt));
+        drop(gate);
+        receipt("armed", identity);
+        true
+    }
+
+    pub fn disarm() {
+        let armed = GATE.lock().unwrap().armed.take();
+        if let Some((identity, receipt)) = armed {
+            receipt("disarmed", identity);
+        }
+    }
+
+    pub(super) fn stall_description_read(get: bool, path: &str, deadline: Instant) {
+        if !get || path != "/xml/device_description.xml" {
+            return;
+        }
+        let armed = GATE.lock().unwrap().armed.take();
+        if let Some((identity, receipt)) = armed {
+            receipt("stall-start", identity);
+            std::thread::sleep(
+                (deadline + std::time::Duration::from_millis(50))
+                    .saturating_duration_since(Instant::now()),
+            );
+            receipt("stall-end", identity);
+        }
+    }
+}
